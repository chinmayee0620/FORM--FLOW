# =================================================================
# FormFlow Backend Environment Configuration
# =================================================================

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=false

# -----------------------------------------------------------------
# Google Cloud Platform (GCP) OAuth 2.0 Credentials
# Required for REAL Google Drive connection
# Obtain these from: https://console.cloud.google.com/
# 1. Enable 'Google Drive API' in APIs & Services.
# 2. Configure OAuth Consent Screen (Add scope: https://www.googleapis.com/auth/drive.readonly)
# 3. Create Credentials -> OAuth client ID (Web Application)
# 4. Add Authorized redirect URI: http://localhost:8000/api/auth/google/drive/callback
# -----------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/drive/callback

# -----------------------------------------------------------------
# Security: Token Encryption Key
# Fernet 32-byte urlsafe base64 string for encrypting refresh tokens at rest.
# Generate in Python: from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())
# -----------------------------------------------------------------
ENCRYPTION_KEY=bXlfZm9ybWZsb3dfZGV2X2tleV8zMmJ5dGVzX2Flc18=

# -----------------------------------------------------------------
# LLM Providers (Optional / Future-Ready)
# -----------------------------------------------------------------
ACTIVE_LLM_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.2

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
